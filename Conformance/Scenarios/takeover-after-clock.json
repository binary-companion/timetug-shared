{
  "name": "takeover-after-clock",
  "config": {
    "v": 1, "platform": "linux", "testing": true, "testClockStart": "2026-10-16T13:00:00.000Z", "timeZone": "America/Chicago",
    "connectors": { "google": { "clientID": "test-client", "clientSecret": "test-secret" } }
  },
  "files": {
    "accounts.json": [ { "kindID": "google", "connectionID": "conn-1", "displayName": "me@example.com", "config": { "email": "me@example.com" } } ],
    "settings.json": { "takeover": { "takeoverCalendarKeys": ["google-conn-1/me@example.com"] } }
  },
  "host": {
    "http": [
      { "match": "https://oauth2.googleapis.com/token", "method": "POST", "bodyFile": "google-token.json" },
      { "match": "https://www.googleapis.com/calendar/v3/users/me/calendarList", "bodyFile": "google-calendar-list.json" },
      { "match": "https://www.googleapis.com/calendar/v3/calendars/me%40example.com/events", "bodyFile": "google-events-simple.json" }
    ],
    "credentials": { "seed": { "conn-1": { "refresh_token": "test-refresh-token" } } }
  },
  "steps": [
    { "send": { "type": "start" } },
    { "expect": { "events": [ { "type": "ready" } ] } },
    { "expect": { "state": {
      "statuses": { "google-conn-1": { "kind": "ok" } },
      "events": [ { "title": "Design review", "start": "2026-10-16T13:16:00.000Z" } ],
      "nextTakeover": { "fireAt": "2026-10-16T13:15:00.000Z" }
    } } },
    { "send": { "type": "test.advanceClock", "payload": { "seconds": 900 } } },
    { "expect": { "events": [
      { "type": "event.takeoverDue", "payload": { "event": { "title": "Design review" }, "calendarTitle": "Me", "joinURL": "https://meet.google.com/abc-defg-hij" } }
    ] } },
    { "expect": { "state": { "nextTakeover": null } } }
  ]
}
